# Backblaze B2: use a bucket-restricted application key, never a master key.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=recall-production
B2_REGION=us-east-005
B2_LOCK_DAYS=30

# Configure one or both providers. The workspace only shows routes with keys.
RECALL_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL_IMAGE=gemini-3.1-flash-image
GMI_API_KEY=
GMI_IMAGE_BASE_URL=https://console.gmicloud.ai/api/v1/ie/requestqueue/apikey
GMI_MODEL_IMAGE=gpt-image-2-generate

# Provider-specific prices prevent one route's cost from being applied to another.
# RECALL_MODEL and RECALL_MODEL_COST_USD remain backward-compatible defaults.
RECALL_MODEL=gemini-3.1-flash-image
RECALL_MODEL_COST_USD=0.067
RECALL_GOOGLE_MODEL_COST_USD=0.067
RECALL_GMI_MODEL_COST_USD=
RECALL_FALLBACK_MODELS=
RECALL_GOOGLE_FALLBACK_MODELS=
RECALL_GMI_FALLBACK_MODELS=
RECALL_GENERATION_RETRIES=2
RECALL_MAX_ACTIVE_AND_QUEUED_JOBS=20
RECALL_NATIVE_SINK=true

# Optional semantic recall via Gemini embeddings.
RECALL_EMBEDDINGS_ENABLED=false
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Hosted demo safety. Keep public generation small; give integrations an API key.
RECALL_ALLOW_PUBLIC_GENERATE=true
RECALL_PUBLIC_GENERATIONS_PER_HOUR=3
RECALL_PUBLIC_REUSE_CHECKS_PER_HOUR=120
RECALL_MAX_CAPTURE_BYTES=18874368
RECALL_MAX_GENERATED_MEDIA_BYTES=26214400
RECALL_API_KEYS=
RECALL_CORS_ORIGINS=
# A long random secret used only to create non-reversible prompt commitments in reuse receipts.
RECALL_RECEIPT_SECRET=replace-with-a-long-random-secret
